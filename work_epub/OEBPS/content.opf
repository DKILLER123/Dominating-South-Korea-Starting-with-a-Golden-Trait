  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:identifier id="BookId">urn:uuid:6f1c2a48-9b3e-4e77-8d51-2c0a74b9e310</dc:identifier>
    <dc:title>Dominating South Korea: Starting with a Golden Trait</dc:title>
    <dc:language>en</dc:language>
    <dc:creator id="creator">DKILLER1</dc:creator>
    <dc:contributor>Original Korean web serial, translated for this edition</dc:contributor>
    <dc:contributor>Arena Agent Mode · production and typesetting</dc:contributor>
    <dc:publisher>Reader's own edition (unofficial fan translation)</dc:publisher>
    <dc:date>2026-09-14</dc:date>
    <dc:description>Chapters 1–10: the Shilla suite, the sealed corridor, the terms of a blade, Jessica’s café, a photograph two years old, a declined ring, an audited ledger, a first day in office, a cap in a supermarket line, and a bulb changed at nine at night.</dc:description>
    <dc:description>English edition of Chapters 1–10, typeset in the reader's reference stylesheet.</dc:description>
    <dc:subject>Korean entertainment industry</dc:subject>
    <dc:subject>Rebirth</dc:subject>
    <dc:subject>Prosecutor</dc:subject>
    <dc:subject>Chaebol</dc:subject>
    <dc:rights>All rights belong to the original author. This is a fan-produced English edition for private reading.</dc:rights>
    <meta property="dcterms:modified">2026-09-14T00:00:00Z</meta>
